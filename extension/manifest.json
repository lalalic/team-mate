{
  "version": "4.4.4",
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "downloads"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "main.html"
  },
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "agent-prompt.md"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "default_locale": "en"
}
